# App
NODE_ENV=development
LOG_LEVEL=info

# Data stores
DATABASE_URL=postgresql://mr_dan:mr_dan@localhost:5432/mr_dan?schema=public
CHROMA_URL=http://localhost:8001

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5
FETCH_K=20
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_LOW_RELEVANCE_THRESHOLD=0.45

# Rerank
RERANK_ENABLED=true
RERANK_TOP_N=5
RERANK_MIN_SCORE=3

# Hybrid
HYBRID_SEARCH_ENABLED=true
HYBRID_BM25_WEIGHT=0.4

# Cascade (off by default)
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_COUNT=3
LOOSE_PROMPT_ENABLED=false

# Cache
CACHE_SEMANTIC_ENABLED=true
CACHE_SEMANTIC_THRESHOLD=0.97
CACHE_TTL_EMBEDDING=3600
CACHE_TTL_LLM=86400

# Upload
MAX_UPLOAD_MB=20
