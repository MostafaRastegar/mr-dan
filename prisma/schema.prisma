generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id               String         @id @default(uuid())
  filename         String
  originalFilename String
  sourcePath       String
  fileType         String // json | md | txt | pdf
  contentHash      String         @unique
  chunkCount       Int            @default(0)
  ingestedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  runs             IngestionRun[]

  @@index([ingestedAt])
}

model IngestionRun {
  id         String    @id @default(uuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status     String // started | succeeded | failed
  chunkCount Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([documentId, startedAt])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  sources        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String? @unique
  passwordHash String
  role         String // "student" | "counselor" | "admin" — validated by zod, not a PG enum
  fullName     String
  grade        String? // دهم | یازدهم | دوازدهم | فارغ‌التحصیل
  fieldOfStudy String? // ریاضی فیزیک | علوم تجربی | علوم انسانی | فنی حرفه‌ای
  schoolName   String?

  age           Int?    // years, 10..100
  gender        String? // "male" | "female" — zod-validated, not a PG enum (matches role)
  heightCm      Int?    // 100..250
  weightKg      Int?    // 30..300
  activityLevel String? // sedentary | light | moderate | active | very_active
  dietGoal      String? // lose | maintain | gain

  groupId     String?
  group       Group?  @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  counselorId String?
  counselor   User?   @relation("CounselorStudents", fields: [counselorId], references: [id], onDelete: SetNull)
  students    User[]  @relation("CounselorStudents")

  ownedGroups Group[]   @relation("GroupOwner")
  sessions    Session[]
  weeklySchedule WeeklySchedule[] @relation("StudentSchedule")
  homework       Homework[]       @relation("StudentHomework")
  freeTimeBudgets FreeTimeBudget[] @relation("StudentFreeTimeBudgets")
  mealPlans      MealPlan[]       @relation("StudentMealPlans")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([groupId])
  @@index([counselorId])
}

model WeeklySchedule {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation("StudentSchedule", fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = شنبه … 6 = جمعه (Persian week; zod-validated 0..6)
  startMinute Int      // minutes from local midnight, 0..1439
  endMinute   Int      // > startMinute, <= 1439
  subject     String   // slug from domain/subjects.ts, validated at the boundary
  teacher     String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, dayOfWeek, startMinute])
}

model Homework {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation("StudentHomework", fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  subject     String?   // slug from domain/subjects.ts; null = «بدون درس»
  priority    Int       // 3 = high, 2 = medium, 1 = low (domain exposes labels)
  deadline    DateTime  // Iran midnight (UTC+03:30) of the due calendar day
  completedAt DateTime? // null = pending
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  planEntries HomeworkPlanEntry[]

  @@index([studentId, completedAt, priority])
}

model FreeTimeBudget {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation("StudentFreeTimeBudgets", fields: [studentId], references: [id], onDelete: Cascade)
  dayKey      String // "YYYY-MM-DD" Iran day (UTC+03:30)
  freeMinutes Int // 0..1439, validated at the boundary; never negative
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planEntries HomeworkPlanEntry[]

  @@unique([studentId, dayKey])
}

model HomeworkPlanEntry {
  id             String         @id @default(uuid())
  studentId      String // part of the composite FK to FreeTimeBudget
  dayKey         String
  budget         FreeTimeBudget @relation(fields: [studentId, dayKey], references: [studentId, dayKey], onDelete: Cascade, onUpdate: Cascade)
  homeworkId     String
  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  plannedMinutes Int // 1..1439
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([homeworkId, dayKey])
  @@index([studentId, dayKey])
}

model MealPlan {
  id             String   @id @default(uuid())
  studentId      String
  student        User     @relation("StudentMealPlans", fields: [studentId], references: [id], onDelete: Cascade)
  dayKey         String // "YYYY-MM-DD" Iran day (UTC+03:30)
  targetCalories Int
  meals          Json // [{ slot, label, calories }]; sum === targetCalories
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, dayKey])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  targetGrade String?
  targetField String?
  color       String   @default("#4A90D9")
  counselorId String
  counselor   User     @relation("GroupOwner", fields: [counselorId], references: [id], onDelete: Cascade)
  members     User[]   @relation("GroupMembers")
  createdAt   DateTime @default(now())

  @@index([counselorId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
