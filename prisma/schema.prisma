generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id               String         @id @default(uuid())
  filename         String
  originalFilename String
  sourcePath       String
  fileType         String // json | md | txt | pdf
  contentHash      String         @unique
  chunkCount       Int            @default(0)
  ingestedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  runs             IngestionRun[]

  @@index([ingestedAt])
}

model IngestionRun {
  id         String    @id @default(uuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status     String // started | succeeded | failed
  chunkCount Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([documentId, startedAt])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  sources        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String? @unique
  passwordHash String
  role         String // "student" | "counselor" | "admin" | "operator" — validated by zod, not a PG enum
  fullName     String
  grade        String? // دهم | یازدهم | دوازدهم | فارغ‌التحصیل
  fieldOfStudy String? // ریاضی فیزیک | علوم تجربی | علوم انسانی | فنی حرفه‌ای
  schoolName   String?

  age           Int?    // years, 10..100
  gender        String? // "male" | "female" — zod-validated, not a PG enum (matches role)
  heightCm      Int?    // 100..250
  weightKg      Int?    // 30..300
  activityLevel String? // sedentary | light | moderate | active | very_active
  dietGoal      String? // lose | maintain | gain

  sleepMinutes Int? // minutes from local midnight, 0..1439
  wakeMinutes  Int? // minutes from local midnight, 0..1439

  needId               String?
  need                 Need?            @relation(fields: [needId], references: [id], onDelete: SetNull)
  schoolMode           String?
  takesMockExams       Boolean?
  otherOccupiedMinutes Int[]  @default([0, 0, 0, 0, 0, 0, 0])
  homeworkAverageMinutes Int?

  groupId     String?
  group       Group?  @relation("GroupMembers", fields: [groupId], references: [id], onDelete: SetNull)
  counselorId String?
  counselor   User?   @relation("CounselorStudents", fields: [counselorId], references: [id], onDelete: SetNull)
  students    User[]  @relation("CounselorStudents")

  ownedGroups Group[]   @relation("GroupOwner")
  sessions    Session[]
  weeklySchedule WeeklySchedule[] @relation("StudentSchedule")
  homework       Homework[]       @relation("StudentHomework")
  freeTimeBudgets FreeTimeBudget[] @relation("StudentFreeTimeBudgets")
  mealPlans      MealPlan[]       @relation("StudentMealPlans")
  weeklyGoals    WeeklyGoal[]     @relation("StudentWeeklyGoals")
  examResults          StudentExamResult[] @relation("StudentExamResults")
  schoolProgram        SchoolProgramEntry[] @relation("StudentSchoolProgram")
  studyPlan            StudyPlan?       @relation("StudentStudyPlan")
  courses              SupplementaryCourse[] @relation("StudentCourses")
  testRecords          TestRecord[]     @relation("StudentTestRecords")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([groupId])
  @@index([counselorId])
}

model WeeklySchedule {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation("StudentSchedule", fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = شنبه … 6 = جمعه (Persian week; zod-validated 0..6)
  startMinute Int      // minutes from local midnight, 0..1439
  endMinute   Int      // > startMinute, <= 1439
  subject     String   // slug from the Subject catalog (Subject.slug, seeded by scripts/seed-advising.ts), validated at the boundary
  teacher     String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, dayOfWeek, startMinute])
}

model Homework {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation("StudentHomework", fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  subject     String?   // slug from the Subject catalog (Subject.slug, seeded by scripts/seed-advising.ts); null = «بدون درس»
  priority    Int       // 3 = high, 2 = medium, 1 = low (domain exposes labels)
  deadline    DateTime  // Iran midnight (UTC+03:30) of the due calendar day
  completedAt DateTime? // null = pending
  spentMinutes Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt

  planEntries HomeworkPlanEntry[]

  @@index([studentId, completedAt, priority])
}

model FreeTimeBudget {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation("StudentFreeTimeBudgets", fields: [studentId], references: [id], onDelete: Cascade)
  dayKey      String // "YYYY-MM-DD" Iran day (UTC+03:30)
  freeMinutes Int // 0..1439, validated at the boundary; never negative
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  planEntries HomeworkPlanEntry[]

  @@unique([studentId, dayKey])
}

model HomeworkPlanEntry {
  id             String         @id @default(uuid())
  studentId      String // part of the composite FK to FreeTimeBudget
  dayKey         String
  budget         FreeTimeBudget @relation(fields: [studentId, dayKey], references: [studentId, dayKey], onDelete: Cascade, onUpdate: Cascade)
  homeworkId     String
  homework       Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  plannedMinutes Int // 1..1439
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([homeworkId, dayKey])
  @@index([studentId, dayKey])
}

model MealPlan {
  id             String   @id @default(uuid())
  studentId      String
  student        User     @relation("StudentMealPlans", fields: [studentId], references: [id], onDelete: Cascade)
  dayKey         String // "YYYY-MM-DD" Iran day (UTC+03:30)
  targetCalories Int
  meals          Json // [{ slot, label, calories }]; sum === targetCalories
  eatenSlots     String[] @default([]) // "breakfast" | "lunch" | "dinner" | "snack"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, dayKey])
}

model WeeklyGoal {
  id                 String   @id @default(uuid())
  studentId          String
  student            User     @relation("StudentWeeklyGoals", fields: [studentId], references: [id], onDelete: Cascade)
  weekKey            String // Saturday of the Iran week, "YYYY-MM-DD"
  testsDone          Int      @default(0)
  completedBlocks    String[] @default([]) // "<dayKey>:<startMinute>:<minutes>"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([studentId, weekKey])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  targetGrade String?
  targetField String?
  color       String   @default("#4A90D9")
  counselorId String
  counselor   User     @relation("GroupOwner", fields: [counselorId], references: [id], onDelete: Cascade)
  members     User[]   @relation("GroupMembers")
  createdAt   DateTime @default(now())

  @@index([counselorId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Field {
  id        String   @id @default(cuid())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String   @id @default(cuid())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  fieldLabels String[] @default([])
  gradeLabels String[] @default([])
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  author     String
  fieldLabel String?
  codes      String[] @default([])
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Need {
  id     String @id @default(uuid())
  code   String @unique
  label  String
  active Boolean @default(true)
  users  User[]
}

model Exam {
  id      String @id @default(uuid())
  code    String @unique
  label   String
  active  Boolean @default(true)
  results StudentExamResult[]
}

model StudentExamResult {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation("StudentExamResults", fields: [studentId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  taraz     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId])
  @@index([studentId, updatedAt])
}

model SchoolProgramEntry {
  id        String @id @default(uuid())
  studentId String
  student   User   @relation("StudentSchoolProgram", fields: [studentId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  subject   String
  minutes   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, dayOfWeek, subject])
}

model StudyPlan {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     User     @relation("StudentStudyPlan", fields: [studentId], references: [id], onDelete: Cascade)
  counselorId String
  testsTarget Int      @default(300)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     StudyPlanEntry[]
}

model StudyPlanEntry {
  id         String @id @default(uuid())
  studentId  String
  plan       StudyPlan @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  dayOfWeek  Int
  subject    String
  minutes    Int
  testsTarget Int @default(0)
  chapterIds String[] @default([])
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, dayOfWeek, subject])
}

model Chapter {
  id      String @id @default(uuid())
  subject String
  field   String
  grade   String
  number  Int
  title   String
  active  Boolean @default(true)

  @@unique([subject, field, grade, number])
}

model TestRecord {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation("StudentTestRecords", fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  weekKey   String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject, weekKey])
}

model SupplementaryCourse {
  id            String @id @default(uuid())
  studentId     String
  student       User   @relation("StudentCourses", fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  mode          String
  weeklyMinutes Int?
  createdAt     DateTime @default(now())

  @@index([studentId])
}
