{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "next", "import", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "src/generated/**",
    "mr-rag/**",
    "coverage/**",
    "public/**"
  ],
  "rules": {
    "no-console": "off",
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "warn",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "test/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
