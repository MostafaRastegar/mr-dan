{
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "warn",
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "src/generated/**",
    "mr-rag/**",
    "coverage/**",
    "public/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "scripts/**/*.ts", "test/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
